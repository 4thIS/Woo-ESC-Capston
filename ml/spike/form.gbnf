char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
intent ::= ("\"event.add\"" | "\"event.change\"" | "\"event.remove\"" | "\"exam.add\"" | "\"exam.change\"" | "\"exam.remove\"" | "\"class.add\"" | "\"class.change\"" | "\"class.remove\"" | "\"request.approve\"" | "\"request.reject\"" | "\"ask.free_rooms\"" | "\"ask.schedule\"" | "\"ask.requests\"" | "\"ask.node\"" | "\"fill\"" | "\"cancel\"" | "\"unknown\"")
intent-kv ::= "\"intent\"" space ":" space intent
root ::= "{" space v-kv "," space intent-kv "," space target-kv "," space set-kv space "}"
set ::= "{" space  (set-rooms-kv set-rooms-rest | set-when-kv set-when-rest | set-time-kv set-time-rest | set-type-kv set-type-rest | set-subject-kv set-subject-rest | set-professor-kv set-professor-rest | set-reason-kv set-reason-rest | set-requester-kv )? space "}"
set-kv ::= "\"set\"" space ":" space set
set-professor ::= "\"" char{1,20} "\""
set-professor-kv ::= "\"professor\"" space ":" space set-professor
set-professor-rest ::= ( "," space set-reason-kv )? set-reason-rest
set-reason ::= "\"" char{1,100} "\""
set-reason-kv ::= "\"reason\"" space ":" space set-reason
set-reason-rest ::= ( "," space set-requester-kv )?
set-requester ::= "\"" char{1,20} "\""
set-requester-kv ::= "\"requester\"" space ":" space set-requester
set-rooms ::= "[" space set-rooms-item ("," space set-rooms-item){0,29} space "]"
set-rooms-item ::= "\"" char{1,20} "\""
set-rooms-kv ::= "\"rooms\"" space ":" space set-rooms
set-rooms-rest ::= ( "," space set-when-kv )? set-when-rest
set-subject ::= "\"" char{1,40} "\""
set-subject-kv ::= "\"subject\"" space ":" space set-subject
set-subject-rest ::= ( "," space set-professor-kv )? set-professor-rest
set-time ::= "\"" char{1,40} "\""
set-time-kv ::= "\"time\"" space ":" space set-time
set-time-rest ::= ( "," space set-type-kv )? set-type-rest
set-type ::= ("\"수업\"" | "\"시험\"" | "\"휴강\"" | "\"빈강의실\"" | "\"특강\"" | "\"대여\"")
set-type-kv ::= "\"type\"" space ":" space set-type
set-type-rest ::= ( "," space set-subject-kv )? set-subject-rest
set-when ::= "\"" char{1,40} "\""
set-when-kv ::= "\"when\"" space ":" space set-when
set-when-rest ::= ( "," space set-time-kv )? set-time-rest
space ::= | " " | "\n"{1,2} [ \t]{0,20}
target ::= "{" space  (target-rooms-kv target-rooms-rest | target-when-kv target-when-rest | target-time-kv target-time-rest | target-type-kv target-type-rest | target-subject-kv target-subject-rest | target-professor-kv target-professor-rest | target-reason-kv target-reason-rest | target-requester-kv )? space "}"
target-kv ::= "\"target\"" space ":" space target
target-professor ::= "\"" char{1,20} "\""
target-professor-kv ::= "\"professor\"" space ":" space target-professor
target-professor-rest ::= ( "," space target-reason-kv )? target-reason-rest
target-reason ::= "\"" char{1,100} "\""
target-reason-kv ::= "\"reason\"" space ":" space target-reason
target-reason-rest ::= ( "," space target-requester-kv )?
target-requester ::= "\"" char{1,20} "\""
target-requester-kv ::= "\"requester\"" space ":" space target-requester
target-rooms ::= "[" space target-rooms-item ("," space target-rooms-item){0,29} space "]"
target-rooms-item ::= "\"" char{1,20} "\""
target-rooms-kv ::= "\"rooms\"" space ":" space target-rooms
target-rooms-rest ::= ( "," space target-when-kv )? target-when-rest
target-subject ::= "\"" char{1,40} "\""
target-subject-kv ::= "\"subject\"" space ":" space target-subject
target-subject-rest ::= ( "," space target-professor-kv )? target-professor-rest
target-time ::= "\"" char{1,40} "\""
target-time-kv ::= "\"time\"" space ":" space target-time
target-time-rest ::= ( "," space target-type-kv )? target-type-rest
target-type ::= ("\"수업\"" | "\"시험\"" | "\"휴강\"" | "\"빈강의실\"" | "\"특강\"" | "\"대여\"")
target-type-kv ::= "\"type\"" space ":" space target-type
target-type-rest ::= ( "," space target-subject-kv )? target-subject-rest
target-when ::= "\"" char{1,40} "\""
target-when-kv ::= "\"when\"" space ":" space target-when
target-when-rest ::= ( "," space target-time-kv )? target-time-rest
v ::= ("1")
v-kv ::= "\"v\"" space ":" space v
